# {{.Name}} shell layer (pwsh), generated by `{{.Name}} shell-init --shell pwsh{{if .OSC7}} --osc7{{end}}{{.ConfigArg}}`.
# Load it with: {{.Name}} shell-init --shell pwsh{{if .OSC7}} --osc7{{end}}{{.ConfigArg}} | Out-String | Invoke-Expression. Edit the config, not this output.
$env:{{.EnvShell}} = 'pwsh'
{{- if .OSC7}}

# Report the current folder to the terminal (OSC 7) so new tabs open there.
function __{{.Name}}_osc7 {
    $e = [char]27
    [Console]::Write("$e]7;file://$([System.Net.Dns]::GetHostName())$($PWD.ProviderPath)$e\")
}
{{- end}}

# {{.Name}}: one wrapper around the binary for the two things a child process
# cannot do for its shell. `new` and `resume` write a plan, cd to its folder,
# then start the agent from it; `login ... {{.TerminalFlag}}` sets {{.EnvLogin}} here.
# Everything else goes straight to the binary.
{{- if .ConfigArg}}
# Every call passes this layer's config,{{.ConfigArg}}, unless the arguments
# already name one before a bare --: the one typed wins.
{{- end}}
# Cmdlets are called by their module-qualified names, so an alias or function
# of yours named Set-Location, Remove-Item or the like is never run instead.
# PowerShell consumes a bare -- when calling a function: quote it ('--') to
# pass arguments through to the agent.
function {{.Name}} {
    $bin = (Microsoft.PowerShell.Core\Get-Command -Name '{{.Name}}' -CommandType Application -ErrorAction Stop | Microsoft.PowerShell.Utility\Select-Object -First 1).Source
    $rest = @($args | Microsoft.PowerShell.Utility\Select-Object -Skip 1)
{{- if .ConfigArg}}
    $cfg = @({{.ConfigList}})
    foreach ($a in $args) {
        if ("$a" -eq '--') { break }
        if ("$a" -eq '--config' -or "$a".StartsWith('--config=')) { $cfg = @(); break }
    }
{{- end}}
    if ($args.Count -gt 0 -and @({{.PlanList}}) -contains $args[0]) {
        $plan = [System.IO.Path]::GetTempFileName()
        & $bin{{if .ConfigArg}} @cfg{{end}} $args[0] {{.PlanFlag}} $plan @rest
        $rc = $LASTEXITCODE
        if ($rc -ne 0 -or (Microsoft.PowerShell.Management\Get-Item -LiteralPath $plan).Length -eq 0) {
            Microsoft.PowerShell.Management\Remove-Item -Force -LiteralPath $plan
            $global:LASTEXITCODE = $rc
            return
        }
        $dir = & $bin plan show {{.PlanFlag}} $plan --field {{.DirField}}
        if ($LASTEXITCODE -ne 0) {
            Microsoft.PowerShell.Management\Remove-Item -Force -LiteralPath $plan
            $global:LASTEXITCODE = {{.ExitLaunch}}
            return
        }
        Microsoft.PowerShell.Management\Set-Location -LiteralPath $dir
{{- if .OSC7}}
        __{{.Name}}_osc7
{{- end}}
        & $bin launch {{.PlanFlag}} $plan
        $rc = $LASTEXITCODE
        Microsoft.PowerShell.Management\Remove-Item -Force -ErrorAction SilentlyContinue -LiteralPath $plan
        $global:LASTEXITCODE = $rc
        return
    }
    if ($args.Count -gt 0 -and $args[0] -eq 'login' -and $args -contains '{{.TerminalFlag}}') {
        $out = @(& $bin{{if .ConfigArg}} @cfg{{end}} @args)
        $rc = $LASTEXITCODE
        if ($out.Count -eq 1 -and $out[0].StartsWith('{{.ExportPrefix}}')) {
            $env:{{.EnvLogin}} = $out[0].Substring('{{.ExportPrefix}}'.Length)
            [Console]::Error.WriteLine("{{.Name}}: {{.EnvLogin}}=$env:{{.EnvLogin}} in this shell")
        } elseif ($out.Count -eq 1 -and $out[0] -eq '{{.UnsetLine}}') {
            Microsoft.PowerShell.Management\Remove-Item -ErrorAction SilentlyContinue Env:{{.EnvLogin}}
            [Console]::Error.WriteLine("{{.Name}}: {{.EnvLogin}} unset in this shell")
        } else {
            $out
        }
        $global:LASTEXITCODE = $rc
        return
    }
    & $bin{{if .ConfigArg}} @cfg{{end}} @args
}
{{- range .Aliases}}
function {{.Name}} { {{$.Name}} {{.Args}} @args }
{{- end}}
