# {{.Name}} shell layer (fish), generated by `{{.Name}} shell-init --shell fish{{if .OSC7}} --osc7{{end}}{{.ConfigArg}}`.
# Load it with: {{.Name}} shell-init --shell fish{{if .OSC7}} --osc7{{end}}{{.ConfigArg}} | source. Edit the config, not this output.
set -gx {{.EnvShell}} fish
{{- if .OSC7}}

# Report the current folder to the terminal (OSC 7) so new tabs open there.
function __{{.Name}}_osc7
    builtin printf '\e]7;file://%s%s\e\\' (command hostname) "$PWD"
end
{{- end}}

# {{.Name}}: one wrapper around the binary for the two things a child process
# cannot do for its shell. `new` and `resume` write a plan, cd to its folder,
# then start the agent from it; `login ... --terminal` sets {{.EnvLogin}} here.
# Everything else goes straight to the binary. It calls builtin and command
# forms (builtin cd, builtin printf, command rm), so a function of yours with
# one of those names is never run in their place.
{{- if .ConfigArg}}
# Every call passes this layer's config,{{.ConfigArg}}, unless the arguments
# already name one before a bare --: the one typed wins.
{{- end}}
function {{.Name}} --wraps {{.Name}} --description '{{.Name}} shell layer'
{{- if .ConfigArg}}
    set -l -- cfg{{.ConfigArg}}
    for a in $argv
        if test "$a" = --
            break
        end
        if test "$a" = --config; or string match -q -- '--config=*' "$a"
            set cfg
            break
        end
    end
{{- end}}
    switch "$argv[1]"
        case {{.PlanWords}}
            set -l tmp /tmp
            set -q TMPDIR; and set tmp $TMPDIR
            set -l plan (command mktemp "$tmp/{{.Name}}-plan.XXXXXX"); or return {{.ExitLaunch}}
            command {{.Name}}{{if .ConfigArg}} $cfg{{end}} $argv[1] {{.PlanFlag}} $plan $argv[2..-1]
            set -l rc $status
            if test $rc -ne 0; or not test -s $plan
                command rm -f -- $plan
                return $rc
            end
            set -l dir (command {{.Name}} plan show {{.PlanFlag}} $plan --field {{.DirField}}); and builtin cd $dir
            or begin
                command rm -f -- $plan
                return {{.ExitLaunch}}
            end
{{- if .OSC7}}
            __{{.Name}}_osc7
{{- end}}
            command {{.Name}} launch {{.PlanFlag}} $plan
            set rc $status
            command rm -f -- $plan
            return $rc
        case login
            if contains -- {{.TerminalFlag}} $argv
                set -l out (command {{.Name}}{{if .ConfigArg}} $cfg{{end}} $argv)
                set -l rc $status
                if test (count $out) -eq 1; and string match -q -- '{{.ExportPrefix}}*' $out[1]
                    set -gx {{.EnvLogin}} (string replace -- '{{.ExportPrefix}}' '' $out[1])
                    builtin printf '%s\n' "{{.Name}}: {{.EnvLogin}}=${{.EnvLogin}} in this shell" >&2
                else if test (count $out) -eq 1; and test "$out[1]" = '{{.UnsetLine}}'
                    set -e {{.EnvLogin}}
                    builtin printf '%s\n' "{{.Name}}: {{.EnvLogin}} unset in this shell" >&2
                else if test (count $out) -gt 0
                    builtin printf '%s\n' $out
                end
                return $rc
            end
            command {{.Name}}{{if .ConfigArg}} $cfg{{end}} $argv
        case '*'
            command {{.Name}}{{if .ConfigArg}} $cfg{{end}} $argv
    end
end
{{- range .Aliases}}
function {{.Name}} --wraps '{{$.Name}} {{.Args}}'
    {{$.Name}} {{.Args}} $argv
end
{{- end}}
