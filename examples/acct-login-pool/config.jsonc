{
  "version": 1,
  "default_agent": "claude",
  "profiles": {
    "personal": { "agent": "claude", "home": "~/.claude", "default": true }
  },
  "logins": {
    "alice": { "agents": ["claude"], "kind": "oauth-token", "token": "${ALICE_TOKEN}", "account": "alice@example.com" },
    "bob": { "agents": ["claude"], "kind": "oauth-token", "token": "${BOB_TOKEN}", "account": "bob@example.com" },
    "carol": { "agents": ["claude"], "kind": "oauth-token", "token": "${CAROL_TOKEN}", "account": "carol@example.com" },
    "derek": { "agents": ["claude"], "kind": "oauth-token", "token": "${DEREK_TOKEN}", "account": "derek@example.com" },
    "erin": { "agents": ["claude"], "kind": "oauth-token", "token": "${ERIN_TOKEN}", "account": "erin@example.com" },
    "codex-key": { "agents": ["codex"], "kind": "api-key", "token": "${CODEX_KEY}" },
    // #region pool
    "auto": {
      "agents": ["claude"],
      "kind": "pool",
      "pool": {
        "own": ["alice", "bob"],              // yours: used up almost fully
        "shared": ["carol", "derek", "erin"], // teammates': borrowed up to their caps
        "force": null,                        // a member name overrides every rule
        "shared_borrow_window": "48h",
        "short_unavailable_at_percent": 99,
        "defaults": { "short": 50, "week": 70 },
        "accounts": {
          "alice": { "short": 95, "week": 98 },
          "bob": { "short": 95, "week": 98 }
        },
        "usage_max_age": "60s",
        "key_ttl": "60s"
      }
    },
    // #endregion
    // #region picker
    "picky": {
      "agents": ["claude"],
      "kind": "pool",
      "pool": {
        "own": ["alice", "bob"],
        "shared": ["carol"],
        "picker": { "command": "sh $HOME/picker.sh" }
      }
    }
    // #endregion picker
  }
}
