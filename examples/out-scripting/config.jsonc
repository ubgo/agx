{
  "$schema": "https://raw.githubusercontent.com/ubgo/agx/main/schema/config.schema.json",
  "version": 1,
  "default_agent": "claude",
  "profiles": {
    "personal": { "agent": "claude", "home": "~/.claude", "default": true },
    "work": { "agent": "claude", "home": "~/.claude-work", "login": "carol" },
    "gem": { "agent": "gemini", "home": "~/.gemini", "default": true },
    "pi": { "agent": "pi", "home": "~/.pi/agent", "default": true }
  },
  "logins": {
    "carol": { "agents": ["claude"], "kind": "oauth-token", "token": "plain-fake-carol-token" }
  },
  "projects": {
    "~/projects/client": { "claude": { "profile": "work" } }
  }
}
