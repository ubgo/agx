{
  "version": 1,
  "default_agent": "claude",
  // #region agents
  "agents": {
    // raw args every Claude launch gets first
    "claude": { "defaults": { "args": ["--chrome"] } }
  },
  // #endregion
  // #region profiles
  "profiles": {
    "personal": {
      "agent": "claude",
      "home": "~/.claude",
      "default": true,
      "model": "sonnet",
      "args": ["--verbose"],
      "env": { "TEAM": "core" },
      "claude": { "effort": "high" }
    },
    "work": {
      "agent": "claude",
      "home": "~/.claude-work",
      // skip agents.claude.defaults.args for this profile
      "inherit_defaults": false,
      "args": ["--debug"]
    }
  }
  // #endregion
}
