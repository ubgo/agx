{
  "version": 1,
  "default_agent": "claude",
  "profiles": {
    "personal": { "agent": "claude", "home": "~/.claude", "default": true },
    "work": { "agent": "claude", "home": "~/.claude-work" }
  },
  // #region logins
  "logins": {
    "work-key": { "agents": ["claude"], "kind": "api-key", "token": "${WORK_KEY}" },
    "carol": { "agents": ["claude"], "kind": "oauth-token", "token": "${gopass:personal/claude/carol}" },
    "derek": { "agents": ["claude"], "kind": "oauth-token", "token": "$(gopass show -o personal/claude/derek)" },
    "pasted": { "agents": ["claude"], "kind": "oauth-token", "stored": true },
    "spare": { "agents": ["claude"], "kind": "oauth-token", "token": "${SPARE_CLAUDE_TOKEN}" },
    "vault": { "agents": ["claude"], "kind": "api-key-helper", "command": "gopass show -o work/anthropic-api-key" }
  }
  // #endregion
}
