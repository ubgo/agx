{
  "version": 1,
  "default_agent": "claude",
  "profiles": {
    "work": {
      "agent": "claude",
      "home": "~/.claude-work",
      "default": true,
      "env": { "DEBUG": "1" },
      "claude": { "effort": "high", "settings": { "cleanupPeriodDays": 20 } }
    },
    "codex": { "agent": "codex", "home": "~/.codex", "default": true },
    "gem": { "agent": "gemini", "home": "~/.gemini", "default": true }
  }
}
