{
  "version": 1,
  "default_agent": "claude",
  "profiles": {
    "personal": { "agent": "claude", "home": "~/.claude", "default": true }
  },
  // #region logins
  "logins": {
    "alice": { "agents": ["claude"], "kind": "oauth-token", "stored": true },
    "bob": { "agents": ["claude"], "kind": "oauth-token", "stored": true },
    "console": { "agents": ["claude"], "kind": "api-key", "stored": true },
    "carol": { "agents": ["claude"], "kind": "oauth-token", "token": "${gopass:personal/claude/carol}" },
    "team": { "agents": ["claude"], "kind": "pool", "pool": { "own": ["bob", "alice"] } }
  }
  // #endregion
}
