{
  "version": 1,
  "default_agent": "claude",
  "profiles": {
    "personal": { "agent": "claude", "home": "~/.claude", "default": true },
    // #region profile
    "work": { "agent": "claude", "home": "~/.claude-work", "login": "carol", "live_login": true },
    // #endregion
    "keyed": { "agent": "claude", "home": "~/.claude-work", "login": "carol", "env": { "ANTHROPIC_API_KEY": "fake-key" } },
    "codex": { "agent": "codex", "home": "~/.codex", "default": true }
  },
  "logins": {
    "carol": { "agents": ["claude"], "kind": "oauth-token", "token": "${gopass:personal/claude/carol}" },
    "alice": { "agents": ["claude"], "kind": "oauth-token", "token": "${gopass:personal/claude/alice}" },
    // #region broken
    // Three logins whose token never becomes one usable line.
    "blank": { "agents": ["claude"], "kind": "oauth-token", "token": "$(printf ' ')" },
    "twolines": { "agents": ["claude"], "kind": "oauth-token", "token": "$(printf 'fake-token-a\\nfake-token-b')" },
    "unset": { "agents": ["claude"], "kind": "oauth-token", "token": "${DAVE_TOKEN}" }
    // #endregion
  }
}
